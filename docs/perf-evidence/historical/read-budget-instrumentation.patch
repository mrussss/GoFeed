+++ b/backend/internal/feed/lab.go
@@ -0,0 +1,60 @@
+package feed
+
+import (
+	"context"
+	"errors"
+	"net"
+	"os"
+	"strconv"
+	"sync/atomic"
+	"time"
+)
+
+var labBypass = os.Getenv("LAB_BUDGET") == "off"
+var labAdmissionWait = time.Duration(labInt("LAB_WAIT_MS", int(feedReadWait/time.Millisecond))) * time.Millisecond
+
+func labInt(name string, fallback int) int {
+	if value, err := strconv.Atoi(os.Getenv(name)); err == nil && value >= 0 {
+		return value
+	}
+	return fallback
+}
+
+var labRunning, labPeak, labEntered, labTimeout, labWaitNS, labShed atomic.Int64
+var labPipe, labPipeError, labPipeTimeout, labPipeNS, labCandidates, labFollowFallback, labFollowFill atomic.Int64
+
+func labBegin() func() {
+	labEntered.Add(1)
+	n := labRunning.Add(1)
+	for peak := labPeak.Load(); n > peak && !labPeak.CompareAndSwap(peak, n); peak = labPeak.Load() {
+	}
+	return func() { labRunning.Add(-1) }
+}
+
+func labRecordPipeline(start time.Time, sources [][]string, err error, ctxErr error) {
+	labPipe.Add(1)
+	labPipeNS.Add(int64(time.Since(start)))
+	if err != nil {
+		labPipeError.Add(1)
+		var timeout net.Error
+		if errors.Is(err, context.DeadlineExceeded) || errors.Is(ctxErr, context.DeadlineExceeded) || (errors.As(err, &timeout) && timeout.Timeout()) {
+			labPipeTimeout.Add(1)
+		}
+		return
+	}
+	var n int64
+	for _, member := range sources {
+		n += int64(len(member))
+	}
+	labCandidates.Add(n)
+}
+
+func LabMetrics() map[string]int64 {
+	return map[string]int64{
+		"feed_active": labRunning.Load(), "feed_peak": labPeak.Load(), "feed_entered": labEntered.Load(),
+		"feed_timeout": labTimeout.Load(), "admit_ns": labWaitNS.Load(), "shed": labShed.Load(),
+		"pipe": labPipe.Load(), "pipe_error": labPipeError.Load(), "pipe_timeout": labPipeTimeout.Load(),
+		"pipe_ns": labPipeNS.Load(), "pipe_candidates": labCandidates.Load(),
+		"follow_fallback": labFollowFallback.Load(), "follow_fill": labFollowFill.Load(),
+	}
+}
